UAT_ADMIN_PASSWORD=
UAT_OFFICE_EMAIL=
UAT_OFFICE_PASSWORD=

# The teacher must be active and linked to an active Teacher record.
UAT_TEACHER_EMAIL=
UAT_TEACHER_PASSWORD=
